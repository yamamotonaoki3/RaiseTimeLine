<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.raisetimeline.api.auth.refreshtoken.RefreshTokenMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO refresh_tokens (user_id, token, expires_at, created_at)
        VALUES (#{userId}, #{token}, #{expiresAt}, NOW())
    </insert>

    <select id="findByToken" resultType="com.raisetimeline.api.auth.refreshtoken.RefreshToken">
        SELECT * FROM refresh_tokens WHERE token = #{token}
    </select>

    <!--
        未使用の行だけを使用済みにする。
        同じトークンで同時に2つのリクエストが来ても、更新できるのは片方だけになり、
        もう片方は更新件数0で「先を越された」ことを検知できる。
    -->
    <update id="markUsed">
        UPDATE refresh_tokens
        SET used_at = #{usedAt}, replaced_by = #{replacedBy}
        WHERE token = #{token} AND used_at IS NULL
    </update>

    <!--
        有効期限切れの行だけを削除する。
        used_at が入っているだけの行（＝使用済みだが期限内）は残す。
        再利用検知がその行を証拠として使うため、消すと盗用を検知できなくなる。
    -->
    <delete id="deleteExpired">
        DELETE FROM refresh_tokens WHERE expires_at &lt; #{now}
    </delete>

    <delete id="deleteByToken">
        DELETE FROM refresh_tokens WHERE token = #{token}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM refresh_tokens WHERE user_id = #{userId}
    </delete>

</mapper>
