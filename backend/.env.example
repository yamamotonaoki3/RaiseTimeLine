# ローカル開発用の環境変数のひな形。
#
# 使い方（初回のみ）:
#   cp backend/.env.example backend/.env
# そのうえで、下の「要生成」と書かれた値をすべて生成し直すこと。
# このファイルの値はダミーであり、そのまま使ってはいけない。
#
# 値の生成例:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   openssl rand -base64 48
#
# backend/.env は .gitignore の対象。実値は絶対にコミットしない。
# docker compose はこのディレクトリの .env を自動で読み込み、
# gradlew bootRun へは build.gradle.kts が読み込んで環境変数として渡す。
#
# このファイルは **local プロファイル用**（application-local.yml）である。
# 本番（SPRING_PROFILES_ACTIVE=prod）は .env を使わず、実行環境の環境変数から与える。
# 本番で必要な変数の一覧は application-prod.yml の冒頭コメントを参照。

# ---- PostgreSQL（docker compose が参照）----
POSTGRES_DB=raisetimeline
POSTGRES_USER=raisetimeline_app
# 要生成
POSTGRES_PASSWORD=changeme

# ---- PostgreSQL（Spring が参照。上の POSTGRES_USER / POSTGRES_PASSWORD と同じ値にする）----
DB_USERNAME=raisetimeline_app
# 要生成
DB_PASSWORD=changeme

# ---- JWT 署名鍵 ----
# 要生成。32文字未満だと jjwt が起動時に例外を投げる。48バイト以上を推奨。
# この値が漏れると任意のアクセストークンを偽造でき、全ユーザーへのなりすましが可能になる。
JWT_SECRET=changeme-must-be-at-least-32-characters-long

# ---- MinIO（docker compose が参照）----
MINIO_ROOT_USER=raisetimeline_minio
# 要生成。MinIO の要件により8文字以上。
MINIO_ROOT_PASSWORD=changeme

# ---- MinIO（Spring が S3 認証情報として参照。上の MINIO_ROOT_* と同じ値にする）----
AWS_S3_ACCESS_KEY=raisetimeline_minio
# 要生成
AWS_S3_SECRET_KEY=changeme
