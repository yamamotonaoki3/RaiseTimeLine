{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "e2e": "playwright test --project=chromium",
    "e2e:ui": "playwright test --project=chromium --ui",
    "e2e:all-browsers": "playwright test",
